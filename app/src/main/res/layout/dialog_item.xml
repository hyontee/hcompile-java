<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="48px">
    <ImageView
        android:id="@+id/item_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/dialog_item_btn_none"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="#ffffffff"
        android:id="@+id/item_field1"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Field1\9"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:fontFamily="@font/roboto_regular"
        android:paddingEnd="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_4sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="#ffffffff"
        android:id="@+id/item_field2"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Field2\9"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:fontFamily="@font/roboto_regular"
        android:paddingEnd="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field1"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="#ffffffff"
        android:id="@+id/item_field3"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Field3\9"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:fontFamily="@font/roboto_regular"
        android:paddingEnd="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="#ffffffff"
        android:id="@+id/item_field4"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Field4\9"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:fontFamily="@font/roboto_regular"
        android:paddingEnd="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field3"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
